@{
    var toast = TempData["Toast"] as string;
    var toastType = TempData["ToastType"] as string ?? "success";
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast align-items-center text-bg-@toastType border-0 show app-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3500">
            <div class="d-flex">
                <div class="toast-body">@toast</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Закрыть"></button>
            </div>
        </div>
    </div>
}
