@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="card border-danger">
    <div class="card-body">
        <h1 class="h3 text-danger">Что-то пошло не так</h1>
        <p>Произошла ошибка при обработке запроса. Попробуйте обновить страницу или вернуться на главную.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">На главную</a>
    </div>
</div>
