@model GosExamTemplate.Dtos.Common.PagedIndexDto<GosExamTemplate.Dtos.Tags.TagDto>
@{
    ViewData["Title"] = "Теги";
}

<section class="page-header">
    <h1 class="h3 mb-0">Теги</h1>
    <a asp-action="Create" class="btn btn-primary">Новый тег</a>
</section>

@if (Model.TotalCount > 0)
{
    <p class="text-muted small mb-2">Всего: @Model.TotalCount</p>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state">Тегов пока нет.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th class="text-end">Записей</th>
                        <th class="text-end" style="width: 200px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td><span class="tag-chip">#@t.Name</span></td>
                        <td class="text-end">@t.ItemsCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="@(Model.ToPagination("Tags", "Index"))" />
}
