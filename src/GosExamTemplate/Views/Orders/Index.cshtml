@model GosExamTemplate.Dtos.Common.PagedIndexDto<GosExamTemplate.Dtos.Orders.OrderListDto>
@{
    ViewData["Title"] = "Мои заказы";
}

<section class="page-header">
    <h1 class="h3 mb-0">Мои заказы</h1>
    <a asp-action="Create" class="btn btn-primary">Новый заказ</a>
</section>

@if (Model.TotalCount > 0)
{
    <p class="text-muted small mb-2">Всего: @Model.TotalCount</p>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state">У вас пока нет заказов.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Дата</th>
                        <th>Запись</th>
                        <th class="text-end">Кол-во</th>
                        <th>Статус</th>
                        <th>Комментарий</th>
                        <th class="text-end" style="width: 220px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in Model.Items)
                {
                    <tr>
                        <td>@o.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td><a asp-controller="Items" asp-action="Details" asp-route-id="@o.ItemId">@o.ItemTitle</a></td>
                        <td class="text-end">@o.Quantity</td>
                        <td><span class="badge text-bg-info">@o.Status</span></td>
                        <td class="text-muted small">@o.Comment</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="@(Model.ToPagination("Orders", "Index"))" />
}
