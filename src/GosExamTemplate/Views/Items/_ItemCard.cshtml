@model GosExamTemplate.Dtos.Items.ItemListDto

<div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
    <article class="card card-item h-100">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img class="card-img-top" src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="card-img-placeholder">@Model.Title.Substring(0, Math.Min(2, Model.Title.Length)).ToUpperInvariant()</div>
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title mb-1">@Model.Title</h5>
            <div class="small text-muted mb-2">
                <span class="badge text-bg-light border me-1">@Model.CategoryName</span>
                @foreach (var tag in Model.Tags)
                {
                    <span class="tag-chip">#@tag</span>
                }
            </div>
            <p class="card-text small flex-grow-1">@Model.ShortDescription</p>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <span class="fw-bold">@Model.Price.ToString("N2") ₽</span>
                <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
            </div>
            <div class="small text-muted mt-2">
                <span>Автор: @Model.OwnerName</span>
                <span class="ms-2">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
            </div>
        </div>
    </article>
</div>
