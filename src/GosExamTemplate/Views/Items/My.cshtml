@model GosExamTemplate.Dtos.Items.MyItemsFilterDto
@{
    ViewData["Title"] = "Мои записи";
}

<section class="page-header">
    <div>
        <h1 class="h3 mb-1">Мои записи</h1>
        <p class="text-muted mb-0 small">Поиск по названию/описанию + фильтр по категории + диапазоны даты и цены.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Создать запись</a>
</section>

<form class="filter-panel mb-3" method="get" asp-action="My" data-auto-submit>
    <div class="row g-2">
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted mb-1">Поиск</label>
            <input asp-for="Search" type="search" class="form-control" placeholder="Часть названия или описания" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Категория</label>
            <select asp-for="CategoryId" class="form-select" asp-items="Model.AvailableCategories">
                <option value="">Все</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Дата от</label>
            <input asp-for="DateFrom" type="date" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Дата до</label>
            <input asp-for="DateTo" type="date" class="form-control" />
        </div>
        <div class="col-3 col-md-1">
            <label class="form-label small text-muted mb-1">Цена от</label>
            <input asp-for="PriceFrom" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-3 col-md-1">
            <label class="form-label small text-muted mb-1">до</label>
            <input asp-for="PriceTo" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-12 col-md-1 d-flex align-items-end">
            <a asp-action="My" class="btn btn-outline-secondary w-100">Сброс</a>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">
        У вас пока нет записей по этим критериям.
        <div class="mt-2"><a asp-action="Create" class="btn btn-sm btn-primary">Создать первую</a></div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Items)
        {
            <partial name="_ItemCard" model="item" />
        }
    </div>
}
