@model GosExamTemplate.Dtos.Items.ItemDetailsDto
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = currentUserId != null && currentUserId == Model.OwnerId;
}

<section class="page-header">
    <div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <div class="small text-muted">
            <span class="badge text-bg-light border me-1">@Model.CategoryName</span>
            @foreach (var tag in Model.Tags) { <span class="tag-chip">#@tag</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (isOwner)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
        }
        @if (User.Identity?.IsAuthenticated == true && !isOwner)
        {
            <a asp-controller="Orders" asp-action="Create" asp-route-itemId="@Model.Id" class="btn btn-primary btn-sm">Заказать</a>
        }
    </div>
</section>

<div class="row g-3">
    <div class="col-12 col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded border" alt="@Model.Title" />
        }
        else
        {
            <div class="card-img-placeholder rounded border">@Model.Title.Substring(0, Math.Min(2, Model.Title.Length)).ToUpperInvariant()</div>
        }
    </div>
    <div class="col-12 col-md-7">
        <div class="card">
            <div class="card-body">
                <h2 class="h4">@Model.Price.ToString("N2") ₽</h2>
                <p class="text-muted small mb-2">
                    Автор: <strong>@Model.OwnerName</strong> · добавлено @Model.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")
                </p>
                <hr />
                <p class="mb-0" style="white-space: pre-line">@Model.Description</p>
            </div>
        </div>
    </div>
</div>

<section class="mt-4">
    <h2 class="h5 mb-3">Заказы по этой записи</h2>
    @if (Model.Orders.Count == 0)
    {
        <div class="empty-state">Заказов ещё нет.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Дата</th>
                        <th>Покупатель</th>
                        <th>Количество</th>
                        <th>Статус</th>
                        <th>Комментарий</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                            <td>@order.UserName</td>
                            <td>@order.Quantity</td>
                            <td><span class="badge text-bg-info">@order.Status</span></td>
                            <td class="text-muted">@order.Comment</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
