@model GosExamTemplate.Dtos.Common.PagedIndexDto<GosExamTemplate.Dtos.Categories.CategoryDto>
@{
    ViewData["Title"] = "Категории";
}

<section class="page-header">
    <h1 class="h3 mb-0">Категории</h1>
    <a asp-action="Create" class="btn btn-primary">Новая категория</a>
</section>

@if (Model.TotalCount > 0)
{
    <p class="text-muted small mb-2">Всего: @Model.TotalCount</p>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state">Категорий пока нет.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th class="text-end">Объектов</th>
                        <th class="text-end" style="width: 200px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td class="text-muted small">@c.Description</td>
                        <td class="text-end">@c.ItemsCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="@(Model.ToPagination("Categories", "Index"))" />
}
